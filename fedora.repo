baseurl=https://download.postgresql.org/pub/repos/yum/srpms/15/fedora/fedora-$releasever-$basearch
gpgkey=https://download.postgresql.org/pub/repos/yum/RPM-GPG-KEY-PGDG
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-mongodb-srpm]
name=Casjay MongoDB 8.0 SRPMS - $releasever
baseurl=https://repo.mongodb.org/yum/redhat/9/mongodb-org/8.0/SRPMS/
gpgkey=https://pgp.mongodb.com/server-8.0.asc
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-nodejs-srpm]
name=Casjay NodeSource 22.x SRPMS - $releasever
baseurl=https://rpm.nodesource.com/pub_22.x/nodistro/SRPMS
gpgkey=https://rpm.nodesource.com/gpgkey/ns-operations-public.key
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-yarn-srpm]
name=Casjay Yarn SRPMS
