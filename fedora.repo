# CasjaysDev Fedora Repo Config (x86_64, aarch64)
# Version-agnostic: relies on $releasever (major) and $basearch.
# Docker image for testing: fedora:40, fedora:rawhide

# ---------------------------
# Fedora official repos
# ---------------------------
[casjay-os-release]
name=Casjay Fedora $releasever - $basearch
mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-$releasever&arch=$basearch
enabled=1
gpgcheck=1
countme=1
gpgkey=https://fedoraproject.org/static/fedora.gpg
metadata_expire=86400
enabled_metadata=1
exclude=runc,php*,npm,nodejs
skip_if_unavailable=1

[casjay-os-updates]
name=Casjay Fedora $releasever Updates - $basearch
mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f$releasever&arch=$basearch
enabled=1
gpgcheck=1
countme=1
gpgkey=https://fedoraproject.org/static/fedora.gpg
metadata_expire=86400
enabled_metadata=1
exclude=runc,php*,npm,nodejs
skip_if_unavailable=1

[casjay-os-updates-testing]
name=Casjay Fedora $releasever Updates Testing - $basearch
mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=updates-testing-f$releasever&arch=$basearch
enabled=0
gpgcheck=1
countme=1
gpgkey=https://fedoraproject.org/static/fedora.gpg
metadata_expire=86400
enabled_metadata=0
exclude=runc
skip_if_unavailable=1


# ---------------------------
# CasjaysDev repos (mirrorlists) - third party
# ---------------------------
[casjay-extras]
name=Casjay Extras - $releasever $basearch
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/$releasever/$basearch/mirrors/extras
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/keys/RPM-GPG-KEY-casjay
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-rpms]
name=Casjay RPMs - $releasever $basearch
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/$releasever/$basearch/mirrors/rpms
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/keys/RPM-GPG-KEY-casjay
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-addons]
name=Casjay Addons - $releasever $basearch
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/$releasever/$basearch/mirrors/addons
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/keys/RPM-GPG-KEY-casjay
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-debug]
name=Casjay Debug - $releasever $basearch
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/$releasever/$basearch/mirrors/debug
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/keys/RPM-GPG-KEY-casjay
module_hotfixes=1
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-sources]
name=Casjay Sources - $releasever
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/$releasever/mirrors/srpms
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/Fedora/keys/RPM-GPG-KEY-casjay
module_hotfixes=1
enabled=0
gpgcheck=1
skip_if_unavailable=1


# ---------------------------
# RPM Fusion - third party
# ---------------------------
[casjay-rpmfusion-free]
name=Casjay RPM Fusion Free for Fedora - $releasever $basearch
mirrorlist=https://mirrors.rpmfusion.org/mirrorlist?repo=free-fedora-$releasever&arch=$basearch
gpgkey=https://download1.rpmfusion.org/free/fedora/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-rpmfusion-nonfree]
name=Casjay RPM Fusion Nonfree for Fedora - $releasever $basearch
mirrorlist=https://mirrors.rpmfusion.org/mirrorlist?repo=nonfree-fedora-$releasever&arch=$basearch
gpgkey=https://download1.rpmfusion.org/nonfree/fedora/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1


# ---------------------------
# Remi - third party
# ---------------------------
[casjay-remi-base]
name=Casjay Remi - $releasever $basearch
baseurl=https://rpms.remirepo.net/fedora/$releasever/remi/$basearch/
gpgkey=https://rpms.remirepo.net/RPM-GPG-KEY-remi2021
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-remi-safe]
name=Casjay Remi Safe - $releasever $basearch
baseurl=https://rpms.remirepo.net/fedora/$releasever/safe/$basearch/
gpgkey=https://rpms.remirepo.net/RPM-GPG-KEY-remi2021
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-remi-php]
name=Casjay Remi PHP 7.4 - $releasever $basearch
baseurl=https://rpms.remirepo.net/fedora/$releasever/php74/$basearch/
gpgkey=https://rpms.remirepo.net/RPM-GPG-KEY-remi2021
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-remi-modular]
name=Casjay Remi Modular - $releasever - $basearch
baseurl=https://rpms.remirepo.net/fedora/$releasever/modular/$basearch/
gpgkey=https://rpms.remirepo.net/RPM-GPG-KEY-remi2021
enabled=0
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=1


# ---------------------------
# COPR (i2pd, incus) - third party
# ---------------------------
[casjay-i2pd]
name=Casjay i2pd (COPR) - $releasever $basearch
baseurl=https://download.copr.fedorainfracloud.org/results/supervillain/i2pd/fedora-$releasever-$basearch/
type=rpm-md
gpgkey=https://download.copr.fedorainfracloud.org/results/supervillain/i2pd/pubkey.gpg
enabled=1
enabled_metadata=1
gpgcheck=1
repo_gpgcheck=0
skip_if_unavailable=1

[casjay-copr-incus]
name=Casjay incus (COPR) - $releasever $basearch
baseurl=https://download.copr.fedorainfracloud.org/results/neil/incus/fedora-$releasever-$basearch/
type=rpm-md
gpgkey=https://download.copr.fedorainfracloud.org/results/neil/incus/pubkey.gpg
enabled=1
enabled_metadata=1
gpgcheck=1
repo_gpgcheck=0
skip_if_unavailable=1


# ---------------------------
# MariaDB / PostgreSQL / MongoDB / Node.js / Yarn / Docker /
# Webmin / Jenkins - third party
# ---------------------------
[casjay-mariadb]
name=Casjay MariaDB 13.rolling for Fedora - $releasever $basearch
baseurl=https://yum.mariadb.org/13.rolling/fedora/$releasever/$basearch
gpgkey=https://yum.mariadb.org/RPM-GPG-KEY-MariaDB
module_hotfixes=1
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-postgresql]
name=Casjay PostgreSQL 15 for Fedora $releasever - $basearch
baseurl=https://download.postgresql.org/pub/repos/yum/15/fedora/fedora-$releasever-$basearch
enabled=0
gpgcheck=1
gpgkey=https://download.postgresql.org/pub/repos/yum/RPM-GPG-KEY-PGDG
skip_if_unavailable=1

[casjay-mongodb]
name=Casjay MongoDB 8.0 - $releasever - $basearch
baseurl=https://repo.mongodb.org/yum/redhat/9/mongodb-org/8.0/$basearch/
gpgcheck=1
enabled=0
gpgkey=https://pgp.mongodb.com/server-8.0.asc
skip_if_unavailable=1

[casjay-nodejs]
name=Casjay NodeSource 22.x - $releasever $basearch
baseurl=https://rpm.nodesource.com/pub_22.x/nodistro/nodejs/$basearch
gpgkey=https://rpm.nodesource.com/gpgkey/ns-operations-public.key
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-yarn]
name=Casjay Yarn - $releasever $basearch
baseurl=https://dl.yarnpkg.com/rpm/
gpgkey=https://dl.yarnpkg.com/rpm/pubkey.gpg
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-docker]
name=Casjay Docker CE - $releasever $basearch
baseurl=https://download.docker.com/linux/fedora/$releasever/$basearch/stable
gpgkey=https://download.docker.com/linux/fedora/gpg
module_hotfixes=1
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-webmin]
name=Casjay Webmin Releases
baseurl=https://download.webmin.com/download/newkey/yum
gpgkey=https://download.webmin.com/developers-key.asc
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-jenkins]
name=Casjay Jenkins
baseurl=https://pkg.jenkins.io/redhat
gpgkey=https://pkg.jenkins.io/redhat/jenkins.io-2023.key
enabled=1
gpgcheck=1
skip_if_unavailable=1


# ---------------------------
# Rawhide (testing only; all disabled by default)
# ---------------------------
[casjay-os-rawhide]
name=Casjay Fedora Rawhide - $basearch
mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=rawhide&arch=$basearch
enabled=0
gpgcheck=1
gpgkey=https://fedoraproject.org/static/fedora.gpg
metadata_expire=86400
enabled_metadata=0
skip_if_unavailable=1

[casjay-os-rawhide-updates]
name=Casjay Fedora Rawhide Updates - $basearch
mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=updates-testing-rawhide&arch=$basearch
enabled=0
gpgcheck=1
gpgkey=https://fedoraproject.org/static/fedora.gpg
metadata_expire=86400
enabled_metadata=0
skip_if_unavailable=1


# ============================
# Source Repositories (SRPMS)
# Pattern: <name>-srpm
# ============================

# ---- Fedora SRPMs ----
[casjay-os-release-srpm]
name=Casjay Fedora $releasever Source
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-source-$releasever&arch=$basearch
gpgkey=https://fedoraproject.org/static/fedora.gpg
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-os-updates-srpm]
name=Casjay Fedora $releasever Updates Source
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-source-f$releasever&arch=$basearch
gpgkey=https://fedoraproject.org/static/fedora.gpg
enabled=0
gpgcheck=1
skip_if_unavailable=1

# ---- RPM Fusion SRPMs - third party ----
[casjay-rpmfusion-free-srpm]
name=Casjay RPM Fusion Free for Fedora - Source - $releasever
baseurl=https://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/SRPMS/
gpgkey=https://download1.rpmfusion.org/free/fedora/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-rpmfusion-nonfree-srpm]
name=Casjay RPM Fusion Nonfree for Fedora - Source - $releasever
baseurl=https://download1.rpmfusion.org/nonfree/fedora/releases/$releasever/Everything/SRPMS/
gpgkey=https://download1.rpmfusion.org/nonfree/fedora/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever
enabled=0
gpgcheck=1
skip_if_unavailable=1

# ---- Remi SRPMs - third party ----
[casjay-remi-srpm]
name=Casjay Remi SRPMS
baseurl=https://rpms.remirepo.net/SRPMS/
gpgkey=https://rpms.remirepo.net/RPM-GPG-KEY-remi2021
enabled=0
gpgcheck=1
skip_if_unavailable=1

# ---- COPR SRPMs - third party (verify layout; disabled by default) ----
[casjay-i2pd-srpm]
name=Casjay i2pd (COPR) - SRPMS - $releasever
baseurl=https://download.copr.fedorainfracloud.org/results/supervillain/i2pd/fedora-$releasever-SRPMS/
gpgkey=https://download.copr.fedorainfracloud.org/results/supervillain/i2pd/pubkey.gpg
enabled=0
gpgcheck=1
repo_gpgcheck=0
skip_if_unavailable=1

[casjay-copr-incus-srpm]
name=Casjay incus (COPR) - SRPMS - $releasever
baseurl=https://download.copr.fedorainfracloud.org/results/neil/incus/fedora-$releasever-SRPMS/
gpgkey=https://download.copr.fedorainfracloud.org/results/neil/incus/pubkey.gpg
enabled=0
gpgcheck=1
repo_gpgcheck=0
skip_if_unavailable=1

# ---- Vendor SRPMs - third party (often missing/inconsistent; disabled) ----
[casjay-mariadb-srpm]
name=Casjay MariaDB 13.rolling SRPMS - $releasever
baseurl=https://archive.mariadb.org/yum/13.rolling/fedora/$releasever/SRPMS/
gpgkey=https://yum.mariadb.org/RPM-GPG-KEY-MariaDB
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-postgresql-srpm]
