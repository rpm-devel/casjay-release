mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/$releasever/$basearch/mirrors/addons
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/keys/RPM-GPG-KEY-casjay
enabled=1
gpgcheck=1
skip_if_unavailable=1

[casjay-debug]
