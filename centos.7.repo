mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/$releasever/$basearch/mirrors/debug
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/keys/RPM-GPG-KEY-casjay
enabled=0
gpgcheck=1
skip_if_unavailable=1

[casjay-sources]
name=Casjay Sources - $releasever
mirrorlist=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/$releasever/mirrors/srpms
gpgkey=https://github.com/rpm-devel/casjay-release/raw/main/ZREPO/EL/keys/RPM-GPG-KEY-casjay
